{
  "permissions": {
    "allow": [
      "Bash(xcodebuild:*)",
      "Bash(swiftlint lint:*)",
      "Bash(grep:*)",
      "Bash(xcrun simctl:*)",
      "Bash(claude mcp:*)",
      "Bash(git checkout -b fix/open-notification-settings)",
      "Bash(git push)",
      "Bash(gh pr:*)",
      "Bash(git checkout:*)",
      "WebSearch",
      "Bash(git add:*)",
      "Bash(xcrun xcresulttool:*)",
      "Bash(while read:*)",
      "Bash(do echo:*)",
      "Read(//Users/felipemorandin/Developer/focused-time/**)",
      "Bash(done)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if echo '$TOOL_INPUT' | grep -q '\\.swift'; then swiftlint lint --config 'Focused Timer/.swiftlint.yml' --quiet; fi"
          }
        ]
      }
    ]
  },
  "outputStyle": "Explanatory"
}
