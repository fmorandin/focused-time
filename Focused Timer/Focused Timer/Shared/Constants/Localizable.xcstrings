    "focusExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "During the focus - the orange color - the idea is that all concentration is directed to the activity to be completed. Usually, this is a 25 minutes timer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante o foco - cor laranja - a ideia é que toda concentração seja direcionada para a atividade a ser concluída. Normalmente esse tempo dura 25 minutos."
          }
        }
      }
    },
    "focusExplanationTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foco"
          }
        }
      }
    },
    "focusName" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foco"
          }
        }
      }
    },
    "longBreakExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The long break - the green color - is a longer period of rest after a few cycles of focus and short breaks. Usually, this is a 30 minutes timer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pausa longa - cor verde - é um período maior de descanso depois de alguns ciclos de foco e descanso. Normalmente essa pausa dura 30 minutos."
          }
        }
      }
    },
    "longBreakExplanationTitle" : {
      "extractionState" : "manual",
      "localizations" : {
