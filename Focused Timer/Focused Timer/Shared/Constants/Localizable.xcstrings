    "shortBreakExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The short break - the blue color - happens just after the time of focus and, during that time, nothing related to the activity should be done. The short break is, by default, a 5 minutes timer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pausa curta - cor azul - acontece logo após ao tempo de foco e, durante esse tempo, nada relacionado à atividade deve ser feito e dura, por padrão, 5 minutos. "
          }
        }
      }
    },
    "shortBreakExplanationTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Short Break"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa Curta"
          }
        }
      }
    },
