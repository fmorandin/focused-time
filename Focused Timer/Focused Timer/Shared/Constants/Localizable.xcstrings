      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update the configurations for the timer with an active timer running or paused will cause the whole cicle to refresh. Close the settings without change to prevent this from happening."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualizar as configurações de timer com um timer ativo ou pausado fará a tela recarregar. Para evitar isso, feche a janela sem alterações."
          }
        }
      }
