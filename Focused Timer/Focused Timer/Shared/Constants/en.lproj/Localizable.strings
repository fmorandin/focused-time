// MARK: - Help Screen

"techniqueExplanationTitle" = "The technique";
"techniqueExplanation" = "The technique consists of having set times for total focus on the activity, a short break and a long break - after a few cycles of focus and short breaks.";

"focusExplanationTitle" = "Focus"; 
"focusExplanation" = "During the focus - the orange color - the idea is that all concentration is directed to the activity to be completed. Usually, this is a 25 minutes timer.";

"shortBreakExplanationTitle" = "Short Break";
"shortBreakExplanation" = "The short break - the blue color - happens just after the time of focus and, during that time, nothing related to the activity should be done. The short break is, by default, a 5 minutes timer.";

"longBreakExplanationTitle" = "Long Break";
"longBreakExplanation" = "The long break - the green color - is a longer period of rest after a few cycles of focus and short breaks. Usually, this is a 30 minutes timer.";

"numberOfCyclesExplanationTitle" = "Number of Cycles";
"numberOfCyclesExplanation" = "The number of focus that the user must to be completed before the long break.";

